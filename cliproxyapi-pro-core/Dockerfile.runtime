FROM debian:bookworm@sha256:f37a335e82bca302e955fa39f9dfe28f1be618f016f8a2b56318e5a5111afc26

ARG TARGETARCH

RUN mkdir -p /CLIProxyAPI/usage /CLIProxyAPI/static

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl tzdata; \
    rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/komari-monitor/komari-agent:latest /app/komari-agent /CLIProxyAPI/komari-agent

WORKDIR /CLIProxyAPI

COPY binaries/linux/${TARGETARCH}/CLIProxyAPI /CLIProxyAPI/CLIProxyAPI
COPY config.example.yaml /CLIProxyAPI/config.example.yaml
COPY management.html /CLIProxyAPI/static/management.html
COPY entrypoint.sh /CLIProxyAPI/entrypoint.sh

ENV TZ=Asia/Shanghai
ENV MANAGEMENT_STATIC_PATH=/CLIProxyAPI/static/management.html
ENV USAGE_DATA_DIR=/CLIProxyAPI/usage
ENV USAGE_DB_PATH=/CLIProxyAPI/usage/usage.sqlite
ENV USAGE_BATCH_SIZE=100
ENV USAGE_POLL_INTERVAL_MS=500
ENV USAGE_QUERY_LIMIT=50000
ENV USAGE_QUEUE_RETENTION_SECONDS=3600
ENV USAGE_QUEUE_MAX_ITEMS=100000
ENV USAGE_QUEUE_MAX_BYTES=268435456

VOLUME ["/CLIProxyAPI/usage"]

EXPOSE 8317

RUN chmod -R 777 /CLIProxyAPI && chmod +x /CLIProxyAPI/entrypoint.sh

CMD ["/CLIProxyAPI/entrypoint.sh"]
